{
  "name": "dfg.codes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#server/*": "./server/*",
    "#generated/*": "./generated/*"
  },
  "scripts": {
    "predev": "run-s db:ensure",
    "dev": "run-p dev:app dev:discussion",
    "dev:app": "react-router dev",
    "dev:discussion": "bun --env-file=.env --watch server/dev.ts",
    "build": "react-router build",
    "env:init": "bun scripts/generateEnvFile.ts",
    "start": "bun server/index.ts",
    "pretest:e2e": "run-s build",
    "test:e2e": "node --env-file=.env ./node_modules/playwright/cli.js test",
    "test:unit": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project unit",
    "test:api": "ops dev db test -- node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --project api",
    "test": "run-s lint typecheck test:unit test:api test:e2e",
    "lint": "oxlint .",
    "typecheck": "bunx tsc --noEmit",
    "gm": "bun --env-file=.env -b graphile-migrate",
    "setup": "bun install && NOCONFIRM=1 run-s env:init db:ensure db:latest db:types",
    "db:up": "ops dev db up",
    "db:exec": "ops dev db psql",
    "db:ensure": "bun --env-file=.env scripts/dbEnsure.ts",
    "db:reset": "bun run gm reset --erase",
    "db:latest": "bun run gm watch --once",
    "db:migrate": "graphile-migrate migrate",
    "db:watch": "bun run gm watch",
    "db:types": "bun --env-file=.env -b kysely-codegen --out-file ./generated/DB.ts",
    "db:init": "run-s db:up db:reset"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-json": "^6.0.2",
    "@coderline/alphatab": "1.9.0",
    "@danielfgray/stompbox": "github:DanielFGray/effect-stompbox#v0.2.0",
    "@effect/platform-node": "^4.1.2",
    "@effect/sql-pg": "^4.1.2",
    "@headlessui/react": "^2.2.9",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.0",
    "@react-router/node": "^7.18.5",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-table": "^8.21.3",
    "@webcontainer/api": "^1.6.1",
    "clsx": "^2.1.1",
    "codehike": "^1.0.7",
    "codemirror": "^6.0.2",
    "coi-serviceworker": "^0.1.7",
    "effect": "^4.1.2",
    "gigbag.js": "github:DanielFGray/alphatab-kit#v0.4.1",
    "graphile-migrate": "^1.4.1",
    "isbot": "^5",
    "kysely": "^0.29.2",
    "lodash": "^4.17.23",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.7",
    "react-aria-components": "^1.15.1",
    "react-dom": "^19.2.7",
    "react-inspector": "^9.0.0",
    "react-router": "^7.18.5",
    "reading-time": "^1.5.0",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.0.0",
    "s-ago": "^2.2.0",
    "unist-util-visit": "^5.0.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@effect/language-service": "^0.86.2",
    "@effect/vitest": "^4.1.2",
    "@playwright/test": "^1.60.0",
    "@react-router/dev": "^7.18.5",
    "@tailwindcss/vite": "^4.3.5",
    "@types/lodash": "^4.17.23",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "kysely-codegen": "^0.20.0",
    "oxfmt": "^0.34.0",
    "oxlint": "^1.49.0",
    "pg": "^8.21.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.6.2",
    "vite": "^8.3.8",
    "vitest": "4.1.12"
  },
  "overrides": {
    "effect": "^4.1.2"
  },
  "patchedDependencies": {
    "@coderline/alphatab@1.9.0": "patches/@coderline%2Falphatab@1.9.0.patch"
  }
}
