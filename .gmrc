{
  "pgSettings": {
    "search_path": "public,auth,hidden"
  },
  "placeholders": {
    ":DATABASE_AUTHENTICATOR": "!ENV",
    ":DATABASE_VISITOR": "!ENV"
  },
  "afterReset": [
    "!afterReset.sql"
  ],
  "afterAllMigrations": [
    {
      "_": "command",
      "shadow": false,
      "command": "bun db:types --url 'env(GM_DBURL)'"
    }
  ],
  "afterCurrent": [
    {
      "_": "command",
      "shadow": false,
      "command": "bun db:types --url 'env(GM_DBURL)'"
    }
  ]
}
