#!/bin/bash
# A fresh worktree, or the tree `ops signoff` exports, has no installed dependencies.
# bun install is safe to run again, so a re-run also repairs stale dependencies.
set -euo pipefail

bun install --frozen-lockfile

# A fresh worktree also has no .env, and the API and e2e tests need its database URLs.
# `ops dev db up` provisions the shared dev databases (never a reset) and writes them;
# env:init then fills in the app's own settings and keeps the database keys.
bun run db:up
bun run env:init
